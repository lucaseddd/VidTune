{
  "manifest_version": 3,
  "name": "VidTune — Speed, Volume & PiP",
  "short_name": "VidTune",
  "version": "0.2.3",
  "description": "Lightweight video speed controls with presets and shortcuts.",
  "action": {
    "default_title": "VidTune",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/shortcuts.js"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "vidtune@vidtune.local",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
